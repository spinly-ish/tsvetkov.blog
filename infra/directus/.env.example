# Скопируй в .env и заполни секреты. .env в .gitignore — не коммитим.
#
# KEY и SECRET генерим командой:
#   openssl rand -hex 32

# Postgres
DB_USER=directus
DB_PASSWORD=change-me-strong-password
DB_NAME=directus

# Directus session/JWT keys
DIRECTUS_KEY=replace-with-openssl-rand-hex-32
DIRECTUS_SECRET=replace-with-another-openssl-rand-hex-32

# Admin user (создаётся при первом старте)
ADMIN_EMAIL=tsvetkov.evgenij@gmail.com
ADMIN_PASSWORD=change-me-strong-password
